# Demo works with no .env. Never commit .env or real email fixtures.
APP_ENV=development
DEMO_MODE=true
# Set production + a random API_KEY before enabling real mailbox access.
API_KEY=
CONFIG_PATH=config/config.example.yaml
RULES_PATH=config/rules.example.yaml
DATABASE_URL=sqlite:///./data/app.db
OUTPUT_DIR=data/digests
LOG_LEVEL=INFO
# Choose one scheduler: n8n or this built-in loop.
SCHEDULER_ENABLED=false
POLL_SECONDS=300
# Optional AI; also set llm.provider: openai in your YAML.
OPENAI_API_KEY=
# Gmail OAuth: request ONLY gmail.readonly; tokens stay in environment/memory.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Digest delivery has separate credentials. Recipient is always fixed here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=
# Optional n8n profile. Use a strong key; preserve it with your encrypted backup.
N8N_ENCRYPTION_KEY=
DIGEST_TIMEZONE=Europe/Berlin
